{
  "name": "flow-mcp",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "flow-mcp": "dist/server/mcp.js"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "FLOW_DIR=.flow bun --watch src/server/http.ts",
    "build": "vite build && bun build src/server/mcp.ts src/server/http.ts --target node --packages external --outdir dist/server",
    "mcp": "node dist/server/mcp.js",
    "seed": "FLOW_DIR=.flow bun scripts/seed.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "^9.0.0",
    "linkedom": "^0.18.15",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "files": [
    "dist",
    "src/server",
    "pi",
    "!src/server/*.test.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pi-package",
    "mcp",
    "mermaid",
    "diagrams"
  ],
  "pi": {
    "extensions": [
      "./pi/extension.ts"
    ]
  },
  "license": "MIT",
  "repository": "github:rawnly/flow",
  "publishConfig": {
    "access": "public"
  }
}

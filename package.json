{
  "name": "flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "flow-mcp": "dist/server/mcp.js"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "FLOW_DIR=.flow tsx watch src/server/http.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "mcp": "node dist/server/mcp.js",
    "seed": "FLOW_DIR=.flow tsx scripts/seed.ts",
    "test": "tsx --test src/server/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "^9.0.0",
    "linkedom": "^0.18.15",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
